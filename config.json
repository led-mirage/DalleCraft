{
    "version": "3.0",
    "api_type": "openai",
    "openai": {
        "api_key_envvar": "OPENAI_API_KEY"
    },
    "foundry": {
        "api_key_envvar": "AZURE_OPENAI_API_KEY",
        "endpoint_envvar": "AZURE_OPENAI_ENDPOINT",
        "flare_deployment": "gpt-image-2.5-flare",
        "sunburst_deployment": "gpt-image-2.5-sunburst"
    },
    "model": {
        "variant": "flare",
        "size": "auto",
        "quality": "auto"
    },
    "system": {
        "window_width": 1024,
        "window_height": 800,
        "welcome_title": "Welcome",
        "welcome_message": "DalleCraft is a tool for generating images using GPT Image 2.5."
    }
}
